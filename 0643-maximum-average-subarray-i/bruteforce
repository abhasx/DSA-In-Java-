  public double findMaxAverage(int[] nums, int k) {
        int left=0;
        double maxAvg=Double.NEGATIVE_INFINITY;
            System.out.println(maxAvg);
        double avg;
            for (int right = k-1; right < nums.length; right++) {
                double sum = 0;
                int adder=left;
                while (adder <= right) {
                    sum += nums[adder];
                    adder++;
                }
                avg = sum / k;
                maxAvg = Math.max(avg, maxAvg);
                left++;

            }
         return maxAvg;}
